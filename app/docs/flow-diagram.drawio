        <mxCell id="arrow-fulltext-es" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2" edge="1" parent="1" source="fulltext-dsl" target="es-box">
