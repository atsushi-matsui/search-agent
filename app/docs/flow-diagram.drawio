        <!-- DSLマージ処理 -->
        <mxCell id="dsl-merge" value="DSLマージ処理&#xa;(Intent に応じて)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="300" y="260" width="120" height="50" as="geometry" />
