        <!-- 矢印: ユーザー入力 → Behavior -->
        <mxCell id="arrow2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2" edge="1" parent="1" source="user-input" target="behavior-box">
          <mxGeometry relative="1" as="geometry" />
