        <!-- Redis -->
        <mxCell id="redis-box" value="Redis&#xa;(DSL履歴/嗜好)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="30" y="240" width="100" height="80" as="geometry" />
