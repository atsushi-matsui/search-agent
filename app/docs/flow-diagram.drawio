        <!-- 全文検索 -->
        <mxCell id="fulltext-dsl" value="全文検索DSL&#xa;(LLMスキップ)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="610" y="260" width="100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="arrow-fulltext" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2" edge="1" parent="1" source="goal-box" target="fulltext-dsl">
          <mxGeometry relative="1" as="geometry" />
