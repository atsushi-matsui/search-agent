          <mxGeometry x="460" y="260" width="130" height="50" as="geometry" />
        </mxCell>
        <mxCell id="arrow-llm" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2" edge="1" parent="1" source="exploratory-box" target="llm-dsl">
          <mxGeometry relative="1" as="geometry" />
