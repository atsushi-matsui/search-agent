          <mxGeometry x="600" y="170" width="90" height="50" as="geometry" />
        </mxCell>
        <mxCell id="arrow-goal" value="「スパイダーマン」&#xa;→ 約6秒" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1;fontSize=9" edge="1" parent="1" source="behavior-box" target="goal-box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- LLM DSL生成 -->
